#!/bin/bash -e
#
# bootc-tar-root - Create a tar.gz from bootc image using guestfish
#
# Handles XFS filesystems using libguestfs (no kernel modules required)
#

echo 'Detecting root partition with guestfish...'

# Use guestfish to inspect the image and create tar
# This works in containers/CI without needing kernel modules
GUESTFISH_OUTPUT=$(guestfish --ro -a "${PACKER_OUTPUT}" <<'GUESTFISH_EOF'
run
list-filesystems
GUESTFISH_EOF
)

# Find the XFS root partition (usually the largest one)
ROOT_DEV=$(echo "$GUESTFISH_OUTPUT" | grep xfs | head -1 | cut -d: -f1)

if [ -z "$ROOT_DEV" ]; then
    echo "ERROR: Could not find XFS root partition!" >&2
    echo "Filesystems found:"
    echo "$GUESTFISH_OUTPUT"
    exit 1
fi

echo "Found root partition: ${ROOT_DEV}"

echo "Creating MAAS image ${OUTPUT}..."
TARFILE=${OUTPUT%*.gz}

# Use guestfish to create tar directly from the image
guestfish --ro -a "${PACKER_OUTPUT}" <<GUESTFISH_TAR
run
mount-ro ${ROOT_DEV} /

# Clean machine-id if it exists
-sh "if [ -f /etc/machine-id ]; then > /etc/machine-id; fi"

# Clean cloud-init state if it exists
-sh "rm -f /var/log/cloud-init*.log /var/lib/cloud/instance 2>/dev/null || true"
-sh "rm -rf /var/lib/cloud/instances 2>/dev/null || true"

# Create tar with proper options
tar-out / ${TARFILE} compress:none numericowner:true xattrs:true selinux:true acls:true excludes:dev excludes:proc excludes:sys
GUESTFISH_TAR

echo "Compressing tar file..."
gzip_cmd="gzip"
command -v pigz >/dev/null 2>&1 && gzip_cmd="pigz"
${gzip_cmd} --best --force "${TARFILE}"

echo 'Done'
